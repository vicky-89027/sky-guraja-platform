{
  "buildCommand": "npm run build --workspace=public-website",
  "outputDirectory": "public-website/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.skyguraja.org/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
