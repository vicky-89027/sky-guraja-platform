{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build --prefix public-website",
  "outputDirectory": "public-website/dist",
  "installCommand": "npm install --prefix public-website",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.skyguraja.org/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
